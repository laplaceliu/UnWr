# UnWr 环境变量示例
#
# 复制为 .env 后按需填写。.env 已被 .gitignore 忽略，不会入库。
# 本文件（.env.example）**应当提交**，用于说明需要哪些变量。

# ------------------------------------------------------------
# 飞书（lark-cli）
# ------------------------------------------------------------
# lark-cli 可执行文件路径。默认从 PATH 查找。
# UNWR_LARK_BIN=/usr/local/bin/lark-cli

# 并发上限。实测并行加速比 4.2×，但飞书 API 有 QPS 限制，默认 8。
# UNWR_MAX_CONCURRENCY=8

# ------------------------------------------------------------
# 模型（由 DSH 宿主管理，此处仅列出常用项）
# ------------------------------------------------------------
# DeepSeek API Key —— DSH 的 llm-deepseek / web-search 插件读取
# DEEPSEEK_API_KEY=sk-xxxxxx

# ------------------------------------------------------------
# 测试（可选）
# ------------------------------------------------------------
# 端到端测试用的作品库 base_token。
# 创建方式：
#   lark-cli base +base-create --name "UnWr 测试库" --as user
#   → 取返回的 base_token
#   → 建表：node --import tsx/esm packages/schema/scripts/init-work.ts <token>
#
# 未设置时，端到端用例会自动跳过，其余单元测试照常运行。
# UNWR_TEST_BASE=

# 端到端测试用的知识空间 ID
# 查看方式：lark-cli wiki +space-list --as user
# UNWR_TEST_SPACE=

# ------------------------------------------------------------
# cordis.yml（源码版 DSH）用此变量拼接插件绝对路径
# ------------------------------------------------------------
# UNWR_ROOT=/path/to/UnWr
